OPENROUTER_API_KEY=
# Required. Derives the three secret feed URLs (digest, reading list,
# everything) and signs image proxy URLs and the web UI's CSRF tokens.
# Generate with: openssl rand -hex 32
WEB_SECRET=replace-with-64-hex-characters
# Optional: FreshRSS refresh URL for the reading list feed (contains a token).
# https://rss.example.com/i/?c=feed&a=actualize&id=<feed id>&ajax=1&user=<user>&token=<token>
FRESHRSS_REFRESH_URL=
